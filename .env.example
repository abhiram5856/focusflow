# =============================================================================
# FocusFlow 150-Day Preparation OS — Environment Configuration
# =============================================================================
# Cross-Device Cloud Sync Configuration (Laptop 1, Laptop 2, Phone)
# Get these credentials from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon / public)
# =============================================================================

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Public Key (Safe for client-side frontend browser use)
# NEVER put your service_role secret key here!
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: If these variables are not provided, FocusFlow automatically defaults
# to 100% Offline LocalStorage Mode with zero loss of functionality.
